# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# .env is gitignored on purpose - never commit real credentials.

#  Postgres (MLflow's backend store) 
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mlflow_db

#  MinIO (local stand-in for S3) 
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me

#  MLflow 
# Full SQLAlchemy URI MLflow uses to reach the Postgres service above.
BACKEND_STORE_URI=postgresql://mlflow:change-me@postgres-service:5432/mlflow_db
# Bucket (in MinIO locally, S3 in prod) MLflow stores model artifacts in.
ARTIFACTS_DESTINATION=s3://mlflow-artifacts
# MLflow's S3 client is pointed at MinIO instead of real AWS for local dev.
MLFLOW_S3_ENDPOINT_URL=http://minio-service:9000
# Reused as MinIO's access/secret key pair locally - keep in sync with the
# MINIO_ROOT_USER / MINIO_ROOT_PASSWORD values above.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=change-me
# Where FastAPI and the training pipeline find MLflow.
MLFLOW_TRACKING_URI=http://mlflow-service:5000

#  Gradio 
# Where Gradio finds FastAPI.
API_URL=http://fastapi-service:8000
# Interface Gradio binds to inside its container - leave as 0.0.0.0.
GRADIO_SERVER_NAME=0.0.0.0

#  Grafana 
# Login as user "admin" with this password.
GRAFANA_ADMIN_PASSWORD=change-me
