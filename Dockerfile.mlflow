FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY requirements-mlflow.txt .
RUN pip install --no-cache-dir -r requirements-mlflow.txt

EXPOSE 5000

CMD ["mlflow", "server", "--backend-store-uri", ${BACKEND_STORE_URI}, "--artifacts-destination", ${ARTIFACTS_DESTINATION}, "--host", "0.0.0.0", "--port", "5000", "--serve-artifacts", "--allowed-hosts", "mlflow-service:5000"]
